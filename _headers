/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Content-Security-Policy: default-src 'self'; base-uri 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; object-src 'none'; script-src 'self' https://unpkg.com; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/styles.css
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/script.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/api/*
  X-Robots-Tag: noindex, nofollow

/owner/*
  X-Robots-Tag: noindex, nofollow

/workspace/*
  X-Robots-Tag: noindex, nofollow

/auth/*
  X-Robots-Tag: noindex, nofollow

/admin
  X-Robots-Tag: noindex, nofollow
