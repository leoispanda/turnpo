# Local-only Stock PDC runtime. Copy to .env.local and fill the keys you use.
# Cloudflare secrets are not exported; reuse the same provider keys locally.
STOCK_PDC_ACCESS_CODE=change-this-local-access-code
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Optional local overrides.
# LOCAL_STOCK_PDC_PORT=8788
# STOCK_PDC_PYTHON=python3
