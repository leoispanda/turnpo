{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnpo.internal/contracts/provider-execution-v1.schema.json",
  "title": "Turnpo Provider Execution API v1",
  "description": "Versioned internal API envelope. The PDC input and scorecard output are defined by PDC AI Contract v1.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "retry_count"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "estimated_usd", "pricing_status", "tracking_status"],
      "properties": {
        "currency": { "const": "USD" },
        "estimated_usd": { "type": ["number", "null"], "minimum": 0 },
        "pricing_status": { "type": "string", "enum": ["CONFIGURED", "NOT_CONFIGURED", "USAGE_UNAVAILABLE"] },
        "tracking_status": { "type": "string", "enum": ["PENDING", "PERSISTED", "LOGGED_ONLY"] }
      }
    },
    "provider_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "status", "attempts", "validation_status", "error_code", "usage", "cost"],
      "properties": {
        "provider": { "type": "string", "enum": ["openai", "claude", "gemini", "deepseek", "kimi"] },
        "model": { "type": "string" },
        "status": { "type": "string", "enum": ["COMPLETED", "FAILED", "NOT_RUN"] },
        "attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
        "validation_status": { "type": "string", "enum": ["VALID", "INVALID", "NOT_RUN"] },
        "error_code": { "type": "string" },
        "usage": { "$ref": "#/$defs/usage" },
        "cost": { "$ref": "#/$defs/cost" }
      }
    },
    "request": {
      "$ref": "https://turnpo.internal/contracts/pdc-ai-contract-v1.schema.json#/$defs/input"
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_version", "evaluation_schema_version", "request_id", "mode", "run_id", "provider_results", "scorecards", "usage", "cost", "validation_status"],
      "properties": {
        "api_version": { "const": "provider-execution-v1" },
        "evaluation_schema_version": { "const": "pdc-ai-contract-v1" },
        "request_id": { "type": "string" },
        "mode": { "type": "string", "enum": ["OFFLINE_TEST", "REAL_SHADOW", "PRODUCTION"] },
        "run_id": { "type": "string" },
        "provider_results": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/provider_result" } },
        "scorecards": {
          "type": "array",
          "items": { "$ref": "https://turnpo.internal/contracts/pdc-ai-contract-v1.schema.json#/$defs/scorecard" }
        },
        "usage": { "$ref": "#/$defs/usage" },
        "cost": { "$ref": "#/$defs/cost" },
        "validation_status": { "type": "string", "enum": ["VALID", "INVALID", "NOT_RUN"] }
      }
    }
  }
}
