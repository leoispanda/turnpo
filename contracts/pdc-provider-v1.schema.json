{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnpo.internal/contracts/pdc-provider-v1.schema.json",
  "title": "Turnpo Provider Gateway Contract v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "unavailable": { "const": "UNAVAILABLE" },
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "$schema": { "type": "string" },
        "$id": { "type": "string" },
        "type": { "enum": ["object", "array", "string", "number", "integer", "boolean", "null"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "properties": { "type": "object" },
        "required": { "type": "array", "items": { "type": "string" } },
        "items": { "$ref": "#/$defs/schema" },
        "additionalProperties": { "const": false },
        "enum": { "type": "array", "minItems": 1 },
        "const": {},
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minItems": { "type": "integer", "minimum": 0 },
        "maxItems": { "type": "integer", "minimum": 0 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_id",
        "run_id",
        "provider_id",
        "model_id",
        "task_type",
        "system_instruction",
        "payload",
        "response_schema"
      ],
      "properties": {
        "contract_version": { "const": "pdc-provider-v1" },
        "request_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "provider_id": { "enum": ["openai", "anthropic", "gemini", "deepseek", "kimi"] },
        "model_id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "task_type": { "enum": ["SCORE", "CHALLENGE", "SMOKE"] },
        "system_instruction": { "type": "string", "minLength": 1, "maxLength": 60000 },
        "payload": { "type": "object" },
        "response_schema": {
          "allOf": [
            { "$ref": "#/$defs/schema" },
            { "properties": { "type": { "const": "object" }, "additionalProperties": { "const": false } } }
          ]
        },
        "timeout_ms": { "type": "integer", "minimum": 1000, "maximum": 30000 },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 1 },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cost_usd": { "type": "number", "minimum": 0, "maximum": 1000 },
            "max_output_tokens": { "type": "integer", "minimum": 128, "maximum": 16000 }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "retry_count"],
      "properties": {
        "input_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/unavailable" }] },
        "output_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/unavailable" }] },
        "total_tokens": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/unavailable" }] },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "usd", "pricing_status", "tracking_status"],
      "properties": {
        "currency": { "const": "USD" },
        "usd": { "anyOf": [{ "type": "number", "minimum": 0 }, { "$ref": "#/$defs/unavailable" }] },
        "pricing_status": { "enum": ["CONFIGURED", "NOT_CONFIGURED", "USAGE_UNAVAILABLE", "UNAVAILABLE"] },
        "tracking_status": { "enum": ["PERSISTED", "LOGGED_ONLY", "UNAVAILABLE"] }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_id",
        "run_id",
        "provider_id",
        "model_id",
        "task_type",
        "status",
        "output",
        "usage",
        "cost",
        "latency_ms",
        "error_code"
      ],
      "properties": {
        "contract_version": { "const": "pdc-provider-v1" },
        "request_id": { "type": "string" },
        "run_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "model_id": { "type": "string" },
        "task_type": { "type": "string" },
        "status": { "enum": ["SUCCESS", "FAIL"] },
        "output": { "anyOf": [{ "type": "object" }, { "$ref": "#/$defs/unavailable" }] },
        "usage": { "$ref": "#/$defs/usage" },
        "cost": { "$ref": "#/$defs/cost" },
        "latency_ms": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/unavailable" }] },
        "error_code": { "type": "string" },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
