{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://turnpo.internal/contracts/pdc-run-publish-v1.schema.json",
  "title": "Turnpo PDC Run Publish Contract v1",
  "description": "Strict, research-only package accepted by Turnpo after local PDC finalization.",
  "oneOf": [
    { "$ref": "#/$defs/publish_request" },
    { "$ref": "#/$defs/publish_response" }
  ],
  "$defs": {
    "risk_flag": {
      "type": "string",
      "enum": [
        "MISSING_DATA",
        "DATA_STALE",
        "HIGH_VOLATILITY",
        "OVERHEATED",
        "WEAK_TREND",
        "LIQUIDITY_RISK",
        "MARKET_REGIME_RISK",
        "BREAKOUT_UNCONFIRMED",
        "MODEL_DISAGREEMENT"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "retry_count"],
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "retry_count": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "provider_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "status", "validation_status", "usage", "estimated_cost_usd"],
      "properties": {
        "provider": { "type": "string", "enum": ["openai", "claude", "gemini", "deepseek", "kimi"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "type": "string", "enum": ["COMPLETED", "FAILED", "NOT_RUN"] },
        "validation_status": { "type": "string", "enum": ["VALID", "INVALID", "NOT_RUN"] },
        "usage": { "$ref": "#/$defs/usage" },
        "estimated_cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "rank", "score", "decision", "risk_flags"],
      "properties": {
        "ticker": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,31}$" },
        "rank": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "score": { "type": "number", "minimum": 0, "maximum": 10 },
        "decision": { "type": "string", "enum": ["BUY", "WATCH", "HOLD", "SELL"] },
        "risk_flags": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/risk_flag" } }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "decision", "risk_flags"],
      "properties": {
        "ticker": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,31}$" },
        "decision": { "type": "string", "enum": ["BUY", "WATCH", "HOLD", "SELL"] },
        "risk_flags": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/risk_flag" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size_bytes", "content_type", "ref"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 52428800 },
        "content_type": { "type": "string", "minLength": 1, "maxLength": 120 },
        "ref": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "publish_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "run_date",
        "snapshot_id",
        "pdc_version",
        "config_hash",
        "code_hash",
        "mode",
        "status",
        "validation_status",
        "candidate_count",
        "provider_results",
        "final_rankings",
        "decisions",
        "risk_flags",
        "cost_summary",
        "execution_summary",
        "artifacts",
        "created_at"
      ],
      "properties": {
        "schema_version": { "const": "pdc-run-publish-v1" },
        "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,79}$" },
        "run_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "snapshot_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$" },
        "pdc_version": { "type": "string", "minLength": 1, "maxLength": 160 },
        "config_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "code_hash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "mode": { "type": "string", "enum": ["OFFLINE_TEST", "REAL_SHADOW", "PRODUCTION"] },
        "status": { "const": "FINALIZED" },
        "validation_status": { "const": "PASS" },
        "candidate_count": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "provider_results": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/provider_result" } },
        "final_rankings": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/ranking" } },
        "decisions": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/decision" } },
        "risk_flags": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/risk_flag" } },
        "cost_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currency", "total_estimated_usd", "pricing_status", "tracking_status"],
          "properties": {
            "currency": { "const": "USD" },
            "total_estimated_usd": { "type": ["number", "null"], "minimum": 0 },
            "pricing_status": { "type": "string", "enum": ["CONFIGURED", "NOT_CONFIGURED", "USAGE_UNAVAILABLE"] },
            "tracking_status": { "type": "string", "enum": ["PERSISTED", "LOGGED_ONLY", "NOT_CONFIGURED"] }
          }
        },
        "execution_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage_count", "completed_stage_count", "checkpoint_status", "research_only", "live_trading"],
          "properties": {
            "stage_count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "completed_stage_count": { "type": "integer", "minimum": 1, "maximum": 100 },
            "checkpoint_status": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "NOT_APPLICABLE"] },
            "research_only": { "const": true },
            "live_trading": { "const": false }
          }
        },
        "artifacts": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/artifact" } },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "publish_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "namespace", "status", "record_sha256", "published_at"],
      "properties": {
        "schema_version": { "const": "pdc-run-publish-v1" },
        "run_id": { "type": "string" },
        "namespace": { "type": "string", "enum": ["shadow", "production"] },
        "status": { "type": "string", "enum": ["PUBLISHED", "IDEMPOTENT"] },
        "record_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "published_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
